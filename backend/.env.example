TRIVY_ADDRESS=:8080
TRIVY_DATABASE_URL=postgres://trivy:trivy-local-only@localhost:5432/trivy?sslmode=disable
TRIVY_ALLOWED_ORIGINS=http://localhost:5173
TRIVY_ALLOW_PRIVATE_TARGETS=false
# Exact host:port entries that may receive intrusive active probes.
TRIVY_INTRUSIVE_ALLOWED_HOSTS=
TRIVY_SCAN_TIMEOUT=60s
TRIVY_REQUEST_TIMEOUT=8s
TRIVY_MAX_RESPONSE_BYTES=2097152
TRIVY_MAX_REQUEST_BYTES=1048576
TRIVY_MAX_REQUESTS_PER_SECOND=10
TRIVY_MAX_CONCURRENCY=5
TRIVY_MAX_SCAN_PAGES=25
TRIVY_MAX_SCAN_DEPTH=2
TRIVY_MAX_SCAN_REQUESTS=100
TRIVY_MAX_CONCURRENT_SCANS=2
TRIVY_RETENTION=168h
TRIVY_CLEANUP_INTERVAL=1h
